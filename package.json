{
	"name": "ai-graph-map",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"check-types": "tsc -b --pretty",
		"lint-es": "eslint --fix \"./**/*.{js,jsx,ts,tsx}\"",
		"lint-es-all": "npm run lint-es",
		"prettify": "prettier --write --config ./.prettierrc.staged.mjs .",
