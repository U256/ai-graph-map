		"d3-zoom": "^3.0.0",
		"normalize.css": "^8.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.88.0",
		"react-select": "^5.10.2"
	},
	"devDependencies": {
		"@types/d3-drag": "^3.0.7",
		"@types/d3-force": "^3.0.10",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.8",
