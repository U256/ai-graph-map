{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "noImplicitAny": false,
        "skipLibCheck": true
    },
    "include": ["*.mjs"],
    "exclude": ["node_modules"]
}
